# 문서(.md)는 저장소에 올리지 않는다 (노트북 로컬 전용)
*.md

# colcon 빌드 결과: 절대경로가 박혀 있어서 각 컴퓨터에서 다시 빌드한다.
# 맨 앞 /는 워크스페이스 최상위만 뜻한다 (하위 폴더의 build, log 같은 이름은 무시하지 않음).
/build/
/install/
/log/

# Arduino: arduino-cli compile --export-binaries가 스케치 폴더 안에 만드는 펌웨어 바이너리
src/motor/firmware/*/build/
*.hex
*.elf

# ROS 2 녹화 (ros2 bag record): 센서 데이터라 크다
rosbag2_*/
*.db3
*.mcap

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# 편집기, AI 도구 설정
.vscode/
.idea/
*.swp
*~
.claude/
