<?xml version="1.0"?>
<!--
  SLAM/Nav2 시험용 방: 안쪽 4m × 4m, 벽 높이 0.5m (LiDAR 스캔 높이 약 0.19m보다 높게).
  지도가 대칭이 되지 않도록 장애물을 비대칭으로 둔다. 로봇은 원점(방 가운데)에서 시작한다.

  바닥과 조명을 model://ground_plane, model://sun으로 불러오지 않고 직접 정의한다.
  launch가 GAZEBO_MODEL_PATH를 설정하면 Gazebo 기본 모델 경로가 빠져서, model:// 모델을 찾으려고
  온라인 모델 서버에 접속하다 월드 로딩이 멈추기 때문이다.
-->
<sdf version="1.6">
  <world name="test_room">
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="north">
          <pose>0 2.05 0.25 0 0 0</pose>
          <geometry><box><size>4.2 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="north">
          <pose>0 2.05 0.25 0 0 0</pose>
          <geometry><box><size>4.2 0.1 0.5</size></box></geometry>
        </visual>
        <collision name="south">
          <pose>0 -2.05 0.25 0 0 0</pose>
          <geometry><box><size>4.2 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="south">
          <pose>0 -2.05 0.25 0 0 0</pose>
          <geometry><box><size>4.2 0.1 0.5</size></box></geometry>
        </visual>
        <collision name="east">
          <pose>2.05 0 0.25 0 0 0</pose>
          <geometry><box><size>0.1 4.0 0.5</size></box></geometry>
        </collision>
        <visual name="east">
          <pose>2.05 0 0.25 0 0 0</pose>
          <geometry><box><size>0.1 4.0 0.5</size></box></geometry>
        </visual>
        <collision name="west">
          <pose>-2.05 0 0.25 0 0 0</pose>
          <geometry><box><size>0.1 4.0 0.5</size></box></geometry>
        </collision>
        <visual name="west">
          <pose>-2.05 0 0.25 0 0 0</pose>
          <geometry><box><size>0.1 4.0 0.5</size></box></geometry>
        </visual>
        <!-- 방을 일부 나누는 칸막이 -->
        <collision name="partition">
          <pose>-0.8 1.0 0.25 0 0 0</pose>
          <geometry><box><size>1.2 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="partition">
          <pose>-0.8 1.0 0.25 0 0 0</pose>
          <geometry><box><size>1.2 0.1 0.5</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="box_obstacle">
      <static>true</static>
      <pose>1.0 0.8 0.2 0 0 0.4</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.4</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="cylinder_obstacle">
      <static>true</static>
      <pose>-1.0 -0.8 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.15</radius><length>0.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.15</radius><length>0.5</length></cylinder></geometry>
        </visual>
      </link>
    </model>

    <model name="small_box">
      <static>true</static>
      <pose>1.2 -1.2 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.6 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.6 0.3</size></box></geometry>
        </visual>
      </link>
    </model>
  </world>
</sdf>
